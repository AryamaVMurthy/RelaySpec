 to be full.", "decode_seconds": 2.4053921019658446, "draft_calls": 65, "event": "benchmark_row", "input_tokens": 168, "mapper_checkpoint_sha256": "16cf8c2000e8b55e51ce3c60c7707d0a98229e4818cf9471a234fa20e7bc660b", "method": "relay_svd1536", "output_hash": "848d60e6bcb65b4a2d29c6c5cdca78702a8a6b2d0a61dd6cb35ab3179edf6902", "output_tokens": 522, "peak_allocated_memory_bytes": 23522510336, "peak_reserved_memory_bytes": 23771217920, "problem_id": "gsm8k/0ec558f29108a864", "profile_regions_ms": {"draft": 409.5429759025574, "prefill_full_target": 34.99763107299805, "prefill_relay": 0.20579199492931366, "relay": 14.082400023937225, "unattributed_runtime": 25.500646460801363, "verification_full_target": 1958.0680656433105}, "proposal_lengths": [15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15], "rank": 0, "reference_answer": "6000", "repetition": 0, "request_seconds": 2.442397511098534, "reserved_memory_after_bytes": 23771217920, "reserved_memory_before_bytes": 23750246400, "target_calls": 65, "time_to_first_token_seconds": 0.03525176318362355, "turn_index": 0}
