.49555206298828, "prefill_relay": 0.41206398606300354, "relay": 17.905312031507492, "unattributed_runtime": 50.22558853775263, "verification_full_target": 1712.1742420196533}, "proposal_lengths": [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 1], "rank": 0, "reference_answer": "2400", "repetition": 0, "request_seconds": 3.12389247212559, "reserved_memory_after_bytes": 21806186496, "reserved_memory_before_bytes": 21806186496, "sampling_seed": 4811778872125368873, "sampling_temperature": 0.6, "target_calls": 56, "time_to_first_token_seconds": 0.0, "turn_index": 0, "verify_count": 56}
