th new square tiles.", "decode_seconds": 7.447325241286308, "draft_calls": 0, "event": "benchmark_row", "input_tokens": 82, "method": "native_ar", "output_hash": "c756e23a83882221e4db852e2105e361c034b9e4198c811ce3c1a6fef9c54da6", "output_tokens": 282, "peak_allocated_memory_bytes": 21503842304, "peak_reserved_memory_bytes": 21806186496, "problem_id": "gsm8k/5c57a1aa62adbafa", "profile_regions_ms": {"unattributed_runtime": 7481.432494707406}, "rank": 0, "reference_answer": "2400", "repetition": 0, "request_seconds": 7.481432494707406, "reserved_memory_after_bytes": 21806186496, "reserved_memory_before_bytes": 21806186496, "sampling_seed": 4811778872125368873, "sampling_temperature": 0.6, "target_calls": 282, "time_to_first_token_seconds": 0.03272397676482797, "turn_index": 0}
