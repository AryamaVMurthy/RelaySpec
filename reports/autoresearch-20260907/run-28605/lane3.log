 = `3 - 2 = 1`\n- `(30,5,20,9)` \u2192 sorted \u2192 `(5,9,20,30)` \u2192 min diff = `9 - 5 = 4`\n\n\u2705 All assertions will pass with this implementation.", "decode_seconds": 5.2671524179168046, "draft_calls": 95, "event": "benchmark_row", "input_tokens": 137, "mapper_checkpoint_sha256": "e9acda081ab9a59c8db4996b10144eb8daf92a63de66ccee8fa20e6cfcdfa14b", "method": "relay_code_2layers", "output_hash": "75ab4cf1c58110183158c1e00dfb8a6fc29d4d101dbe2cd9bf39101754f6425b", "output_tokens": 457, "peak_allocated_memory_bytes": 23269811712, "peak_reserved_memory_bytes": 23446159360, "problem_id": "Mbpp/763", "profile_regions_ms": {"draft": 2198.0703159570694, "prefill_full_target": 34.08233642578125, "prefill_relay": 0.19516800343990326, "relay": 15.702368050813675, "unattributed_runtime": 74.26793229952455, "verification_full_target": 2944.834297180176}, "proposal_lengths": [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 6, 3, 2], "rank": 0, "reference_answer": {"entry_point": "find_min_diff", "tests": ["assert find_min_diff((1,5,3,19,18,25),6) == 1", "assert find_min_diff((4,3,2,6),4) == 1", "assert find_min_diff((30,5,20,9),4) == 4"]}, "repetition": 0, "request_seconds": 5.2671524179168046, "reserved_memory_after_bytes": 23446159360, "reserved_memory_before_bytes": 23441965056, "target_calls": 95, "time_to_first_token_seconds": 0.0, "turn_index": 0, "verify_count": 95}
