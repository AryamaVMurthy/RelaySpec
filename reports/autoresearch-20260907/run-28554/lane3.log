 just about survival. It's about progress. It's about pushing the boundaries of what's possible. It's about inspiring the next generation to think bigger, to dream bigger, to build a future that's not just sustainable", "decode_seconds": 7.948875241912901, "draft_calls": 144, "event": "benchmark_row", "input_tokens": 44, "mapper_checkpoint_sha256": "742f8fa3426e6d34d096e73077f09adcee68106e9b7a1b1bc47ae7b7edd16cf8", "method": "relay_cropped", "output_hash": "7333a15b19d9c38d62d9a1e50b48148f656539e1fd4dde4f383a534ca503fc0f", "output_tokens": 256, "peak_allocated_memory_bytes": 20152144896, "peak_reserved_memory_bytes": 20371734528, "problem_id": "mtbench/10/turn0", "profile_regions_ms": {"draft": 3362.9650206565857, "prefill_full_target": 30.230239868164062, "prefill_relay": 0.19126400351524353, "relay": 23.14591996371746, "unattributed_runtime": 118.66513743251562, "verification_full_target": 4413.677659988403}, "proposal_lengths": [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7], "rank": 0, "reference_answer": null, "repetition": 0, "request_seconds": 7.948875241912901, "reserved_memory_after_bytes": 20371734528, "reserved_memory_before_bytes": 20371734528, "target_calls": 144, "time_to_first_token_seconds": 0.0, "turn_index": 0, "verify_count": 144}
