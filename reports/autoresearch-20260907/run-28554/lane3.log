es and premium features  \n- Long-term value and resale potential\n\n**Conclusion**  \n- Summary of key differences  \n- Recommendation based on user preferences and needs.", "decode_seconds": 8.802064001560211, "draft_calls": 160, "event": "benchmark_row", "input_tokens": 69, "mapper_checkpoint_sha256": "777491607273a8d8e2063bbb3ed06c3d652c874f59b5ea0e048c212cc5d955f9", "method": "relay_n128_random", "output_hash": "9a87df894a23f7953ab3db33023ba5d815ed9f4870e325435624645149ab874c", "output_tokens": 204, "peak_allocated_memory_bytes": 20155531776, "peak_reserved_memory_bytes": 20352860160, "problem_id": "mtbench/2/turn0", "profile_regions_ms": {"draft": 3713.2439703941345, "prefill_full_target": 31.522111892700195, "prefill_relay": 0.18377600610256195, "relay": 25.060160100460052, "unattributed_runtime": 127.77760262787342, "verification_full_target": 4904.27638053894}, "proposal_lengths": [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 1], "rank": 0, "reference_answer": null, "repetition": 0, "request_seconds": 8.802064001560211, "reserved_memory_after_bytes": 20352860160, "reserved_memory_before_bytes": 20352860160, "target_calls": 160, "time_to_first_token_seconds": 0.0, "turn_index": 0, "verify_count": 160}
