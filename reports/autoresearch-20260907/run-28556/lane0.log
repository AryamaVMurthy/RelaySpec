 as:\n\n$$\n\\text{Net Proceeds} = \\text{Selling Price} - \\text{Total Expenses}\n$$\n$$\n= 400{,}000 - 282{,}000 = \\boxed{\\$118{,}000}\n$$\n\n---\n\n### \u2705 Final Answer:\n$$\n\\boxed{\\$118{,}000}\n$$", "decode_seconds": 7.194003777112812, "draft_calls": 124, "event": "benchmark_row", "input_tokens": 109, "mapper_checkpoint_sha256": "8fc64e2481ce5fccf0676d106dd43128bf8b7dfbdabda917cdfdf192c2ff6b87", "method": "relay_reduced", "output_hash": "af752f30ebcbb2f1f531abefacfffe26382ba8f223f465f0a90e6963eeb38c99", "output_tokens": 471, "peak_allocated_memory_bytes": 19887264768, "peak_reserved_memory_bytes": 20103299072, "problem_id": "gsm8k/59c1f5c956a2ede9", "profile_regions_ms": {"draft": 2978.7083827257156, "prefill_full_target": 33.2848014831543, "prefill_relay": 0.23132799565792084, "relay": 22.052287995815277, "unattributed_runtime": 123.1943917684257, "verification_full_target": 4036.532585144043}, "proposal_lengths": [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 2], "rank": 0, "reference_answer": "118000", "repetition": 0, "request_seconds": 7.194003777112812, "reserved_memory_after_bytes": 20103299072, "reserved_memory_before_bytes": 20097007616, "target_calls": 124, "time_to_first_token_seconds": 0.0, "turn_index": 0, "verify_count": 124}
