w many more green jelly beans than red jelly beans\n\n$$\nG - R = 1515 - 1485 = 30\n$$\n\n---\n\n### \u2705 Final Answer:\n\n$$\n\\boxed{30}\n$$\n\nThere are **30 more green jelly beans** than red jelly beans.", "decode_seconds": 6.107074725907296, "draft_calls": 105, "event": "benchmark_row", "input_tokens": 118, "mapper_checkpoint_sha256": "8fc64e2481ce5fccf0676d106dd43128bf8b7dfbdabda917cdfdf192c2ff6b87", "method": "relay_reduced", "output_hash": "614e2e31fdd1b9d5ae18661a94427ee918e23c10bf7b3d655166fade8093aa0d", "output_tokens": 489, "peak_allocated_memory_bytes": 19891448320, "peak_reserved_memory_bytes": 20103299072, "problem_id": "gsm8k/4c9439fa1014db5a", "profile_regions_ms": {"draft": 2484.958171248436, "prefill_full_target": 33.12025451660156, "prefill_relay": 0.20147199928760529, "relay": 18.5864639878273, "unattributed_runtime": 103.27385869249701, "verification_full_target": 3466.9345054626465}, "proposal_lengths": [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 2, 7, 7, 5, 7, 2, 3], "rank": 0, "reference_answer": "30", "repetition": 0, "request_seconds": 6.107074725907296, "reserved_memory_after_bytes": 20103299072, "reserved_memory_before_bytes": 20103299072, "target_calls": 105, "time_to_first_token_seconds": 0.0, "turn_index": 0, "verify_count": 105}
