.} - 10 \\text{ p.m.} = 7 \\text{ hours and } 55 \\text{ minutes} = 475 \\text{ minutes}\n$$\n\nBut during that time, she **was sleepwalking from 2:15 a.m. to 2:38 a.m.**, which is:\n$$\n2:38 \\text{ a.m.} - 2:15 \\text{ a.m.} = 23 \\text{ minutes}\n$$\n\nSo the **actual time she spent sleeping on her bed is**:\n$$\n475 \\text{ minutes} - 23 \\text{ minutes} = \\boxed{452} \\text{ minutes}\n$$\n\n---\n\n### \u2705 **Final Answer:**\n$$\n\\boxed{452} \\text{ minutes}\n$$", "decode_seconds": 4.240792098920792, "draft_calls": 118, "event": "benchmark_row", "input_tokens": 139, "mapper_checkpoint_sha256": "b4562dc664748ec2da6e0f1ccac13820bfd0fa9c413a7a3235ebec5f1d84b613", "method": "relay_base", "output_hash": "a16564e22d7663561ae972d92d14a100aedce783d55c9d13b805a60374707a72", "output_tokens": 519, "peak_allocated_memory_bytes": 20654686720, "peak_reserved_memory_bytes": 20891828224, "problem_id": "gsm8k/1695cf1a111991fc", "profile_regions_ms": {"draft": 619.8314237594604, "prefill_full_target": 37.43241500854492, "prefill_relay": 0.24940800666809082, "relay": 32.02172799408436, "unattributed_runtime": 56.512009628117085, "verification_full_target": 3534.5976028442383}, "proposal_lengths": [15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15], "rank": 0, "reference_answer": "452", "repetition": 0, "request_seconds": 4.280644587241113, "reserved_memory_after_bytes": 20891828224, "reserved_memory_before_bytes": 20891828224, "sampling_seed": 7521377636497194509, "sampling_temperature": 1.0, "target_calls": 118, "time_to_first_token_seconds": 0.03784312820062041,