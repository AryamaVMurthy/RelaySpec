605572, "draft_calls": 58, "event": "benchmark_row", "input_tokens": 118, "mapper_checkpoint_sha256": "f5084dfef9e46b62ae8bd3e603e19b786a76cdf9ae432854730a47c849737fa7", "method": "relay_reduced", "output_hash": "614e2e31fdd1b9d5ae18661a94427ee918e23c10bf7b3d655166fade8093aa0d", "output_tokens": 489, "peak_allocated_memory_bytes": 21296749568, "peak_reserved_memory_bytes": 21529362432, "problem_id": "gsm8k/4c9439fa1014db5a", "profile_regions_ms": {"draft": 364.02806425094604, "prefill_full_target": 32.91606521606445, "prefill_relay": 0.14553600549697876, "relay": 10.787552013993263, "unattributed_runtime": 23.348483588546515, "verification_full_target": 1738.654878616333}, "proposal_lengths": [15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15], "rank": 0, "reference_answer": "30", "repetition": 0, "request_seconds": 2.1698805796913803, "reserved_memory_after_bytes": 21529362432, "reserved_memory_before_bytes": 21529362432, "target_calls": 58, "time_to_first_token_seconds": 0.03310538316145539, "turn_index": 0}
