 all the expenses:\n\n$$\n\\text{Total Expenses} = \\text{Transfer Fees} + \\text{Brokerage Fee} + \\text{Loan Repayment}\n$$\n$$\n= 12{,}000 + 20{,}000 + 250{,}000 = \\$282{,}000\n$$\n\n---\n\n### **Step 6: Net Proceeds**\nNet proceeds are the **selling price minus total expenses**:\n\n$$\n\\text{Net Proceeds} = 400{,}000 - 282{,}000 = \\boxed{\\$118{,}000}\n$$\n\n---\n\n### \u2705 Final Answer:\n$$\n\\boxed{\\$118{,}000}\n$$", "decode_seconds": 6.198834707029164, "draft_calls": 172, "event": "benchmark_row", "input_tokens": 109, "mapper_checkpoint_sha256": "7fb8caa333bb6f810e6f7413f20f0e439285f23b963204d4193d25c4b0731407", "method": "relay_reduced", "output_hash": "78cbc2d6f0ac3a9b572402f7a826c9146ccda82b38c175996a1844695b84cae0", "output_tokens": 444, "peak_allocated_memory_bytes": 18516141056, "peak_reserved_memory_bytes": 18746441728, "problem_id": "gsm8k/59c1f5c956a2ede9", "profile_regions_ms": {"draft": 918.0400643348694, "prefill_full_target": 32.91273498535156, "prefill_relay": 0.10659199953079224, "relay": 36.317952021956444, "unattributed_runtime": 72.73876138404012, "verification_full_target": 5173.8244915008545}, "proposal_lengths": [15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15], "rank": 0, "reference_answer": "118000", "repetition": 0, "request_seconds": 6.233940596226603, "reserved_memory_after_bytes": 18746441728, "reser