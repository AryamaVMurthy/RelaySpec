 like you", "decode_seconds": 6.724497287068516, "draft_calls": 0, "event": "benchmark_row", "input_tokens": 303, "method": "native_ar", "output_hash": "c4c6793809babf3a3a26bd67ccbe82224d89a50aa495851effbf09a972f01e59", "output_tokens": 256, "peak_allocated_memory_bytes": 21679735808, "peak_reserved_memory_bytes": 21997027328, "problem_id": "mtbench/10/turn1", "profile_regions_ms": {"unattributed_runtime": 6769.2512832582}, "rank": 0, "reference_answer": null, "repetition": 0, "request_seconds": 6.7692512832582, "reserved_memory_after_bytes": 21997027328, "reserved_memory_before_bytes": 21997027328, "target_calls": 256, "time_to_first_token_seconds": 0.04328342480584979, "turn_index": 1}
