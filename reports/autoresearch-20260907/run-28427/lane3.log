": 6.2801014059223235, "draft_calls": 0, "event": "benchmark_row", "input_tokens": 44, "method": "native_ar", "output_hash": "4581fbac2f69efadf68fa1ba2129e6d5083f9175590b105495fe9db933bc8224", "output_tokens": 239, "peak_allocated_memory_bytes": 21617560576, "peak_reserved_memory_bytes": 21879586816, "problem_id": "mtbench/10/turn0", "profile_regions_ms": {"unattributed_runtime": 6311.89646339044}, "rank": 0, "reference_answer": null, "repetition": 0, "request_seconds": 6.31189646339044, "reserved_memory_after_bytes": 21879586816, "reserved_memory_before_bytes": 21879586816, "target_calls": 239, "time_to_first_token_seconds": 0.030142480041831732, "turn_index": 0}
