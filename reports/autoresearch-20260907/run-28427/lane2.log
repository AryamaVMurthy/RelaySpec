: "benchmark_row", "input_tokens": 115, "method": "native_ar", "output_hash": "c2d162689652fc3f1a28318c8199c1706be642640b1b97ec1a0be5d7cf9988ba", "output_tokens": 281, "peak_allocated_memory_bytes": 21634456064, "peak_reserved_memory_bytes": 21906849792, "problem_id": "Mbpp/432", "profile_regions_ms": {"unattributed_runtime": 7497.985696885735}, "rank": 0, "reference_answer": {"entry_point": "median_trapezium", "tests": ["assert median_trapezium(15,25,35)==20", "assert median_trapezium(10,20,30)==15", "assert median_trapezium(6,9,4)==7.5"]}, "repetition": 0, "request_seconds": 7.497985696885735, "reserved_memory_after_bytes": 21906849792, "reserved_memory_before_bytes": 21906849792, "target_calls": 281, "time_to_first_token_seconds": 0.03304691566154361, "turn_index": 0}
