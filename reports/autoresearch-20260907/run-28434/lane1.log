 remains. I will live on, not in flesh, but in the earth, in the memory of the forest, in the heart of those who once loved me.", "decode_seconds": 5.206189658958465, "draft_calls": 147, "event": "benchmark_row", "input_tokens": 63, "mapper_checkpoint_sha256": "45501dcf17b0374e7bce878745bc1446ea7146ca94b9241978aac163642cf1f5", "method": "relay_math_seed1730", "output_hash": "fecccaed363fbc4ea6730a28720aece2c4df326add62b64801d79d370998dddf", "output_tokens": 247, "peak_allocated_memory_bytes": 18624284160, "peak_reserved_memory_bytes": 19021168640, "problem_id": "mtbench/19/turn0", "profile_regions_ms": {"draft": 768.5841917991638, "prefill_full_target": 30.59574317932129, "prefill_relay": 0.10259199887514114, "relay": 29.801855966448784, "unattributed_runtime": 60.945222932845354, "verification_full_target": 4348.750713348389}, "proposal_lengths": [15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15], "rank": 0, "reference_answer": null, "repetition": 0, "request_seconds": 5.238780319225043, "reserved_memory_after_bytes": 19021168640, "reserved_memory_before_bytes": 19021168640, "target_calls": 147, "time_to_first_token_seconds": 0.030740836635231972, "turn_index": 0}
