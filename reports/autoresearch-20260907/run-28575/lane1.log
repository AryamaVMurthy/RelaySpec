$", "decode_seconds": 3.6616817619651556, "draft_calls": 100, "event": "benchmark_row", "input_tokens": 95, "mapper_checkpoint_sha256": "a53b21494b39f7139d3a04b206a5698dbf22fbd0fa7192f8f9cc577bcf4a59e9", "method": "relay_two", "output_hash": "66c7548f5f505c2167f13c089a64b334469f0ad7c3d3cf967a6353d886035cda", "output_tokens": 332, "peak_allocated_memory_bytes": 23519396352, "peak_reserved_memory_bytes": 23779606528, "problem_id": "gsm8k/13d10b8bfcf30de5", "profile_regions_ms": {"draft": 634.5034890174866, "prefill_full_target": 33.039424896240234, "prefill_relay": 0.14294399321079254, "relay": 18.550239995121956, "unattributed_runtime": 50.21513994038105, "verification_full_target": 2960.3561000823975}, "proposal_lengths": [15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15], "rank": 0, "reference_answer": "24", "repetition": 0, "request_seconds": 3.696807337924838, "reserved_memory_after_bytes": 23779606528, "reserved_memory_before_bytes": 23754440704, "sampling_seed": 521260812837726876, "sampling_temperature": 1.0, "target_calls": 100, "time_to_first_token_seconds": 0.033297544810920954, "turn_index": 0}
